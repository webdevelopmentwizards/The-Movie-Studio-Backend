{
  "name": "the-movie-studio-backend",
  "type": "commonjs",
  "version": "1.0.0",
  "description": "The Movie Studio backend API",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/app.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/src/app.js",
    "serve": "cross-env NODE_ENV=production node dist/src/app.js",
    "build": "npm run clean && npm run build-ts && npm run keys && npm run copy-templates",
    "build-ts": "tsc",
    "keys": "cpx \"keys/**/*\" dist/keys",
    "copy-templates": "cpx \"src/email_templates/**/*\" dist/email_templates",
    "clean": "rimraf ./dist",
    "pm2": "pm2 start ecosystem.config.cjs",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "WEB DEVELOPMENT WIZARDS TEAM",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^4.6.0",
    "joi": "^17.13.3",
    "jose": "^6.1.1",
    "jsonwebtoken": "^8.5.1",
    "minio": "^8.0.7",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.4",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "cpx": "^1.5.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prisma": "^5.7.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "fsevents": "^2.3.3",
    "chokidar": "^3.5.3"
  }
}
